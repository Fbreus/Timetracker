{
  "name": "vscode-time-tracker",
  "displayName": "Time Tracker",
  "description": "Automatic time tracking for VS Code projects with analytics dashboard, comprehensive Synergy PSA integration, enhanced UX visualizations, Quick Switch, and Pomodoro timer",
  "version": "2.4.1",
  "publisher": "timetracker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fbreus/Timetracker.git"
  },
  "bugs": {
    "url": "https://github.com/Fbreus/Timetracker/issues"
  },
  "homepage": "https://github.com/Fbreus/Timetracker#readme",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:timetracker.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "timetracker.startTracking",
        "title": "Time Tracker: Start Tracking"
      },
      {
        "command": "timetracker.stopTracking",
        "title": "Time Tracker: Stop Tracking"
      },
      {
        "command": "timetracker.pauseTracking",
        "title": "Time Tracker: Pause Tracking"
      },
      {
        "command": "timetracker.resumeTracking",
        "title": "Time Tracker: Resume Tracking"
      },
      {
        "command": "timetracker.showDashboard",
        "title": "Time Tracker: Show Dashboard"
      },
      {
        "command": "timetracker.addManualEntry",
        "title": "Time Tracker: Add Manual Entry"
      },
      {
        "command": "timetracker.exportData",
        "title": "Time Tracker: Export Data"
      },
      {
        "command": "timetracker.openSettings",
        "title": "Time Tracker: Open Settings"
      },
      {
        "command": "timetracker.switchToProject",
        "title": "Time Tracker: Switch to Project"
      },
      {
        "command": "timetracker.viewTimeEntries",
        "title": "Time Tracker: View Time Entries"
      },
      {
        "command": "timetracker.synergy.testConnection",
        "title": "Time Tracker: Test Synergy Connection"
      },
      {
        "command": "timetracker.synergy.syncNow",
        "title": "Time Tracker: Sync to Synergy Now"
      },
      {
        "command": "timetracker.synergy.viewSyncStatus",
        "title": "Time Tracker: View Synergy Sync Status"
      },
      {
        "command": "timetracker.submitToSynergy",
        "title": "Time Tracker: Submit to Synergy PSA"
      },
      {
        "command": "timetracker.testSynergyConnection",
        "title": "Time Tracker: Test Synergy Connection (PSA)"
      },
      {
        "command": "timetracker.syncSynergyProjects",
        "title": "Time Tracker: Sync Synergy Projects"
      },
      {
        "command": "timetracker.selectSynergyProject",
        "title": "Time Tracker: Select Synergy Project"
      },
      {
        "command": "timetracker.syncCustomers",
        "title": "Time Tracker: Sync Customers from Synergy"
      },
      {
        "command": "timetracker.configureEmployeeId",
        "title": "Time Tracker: Configure Synergy Employee ID"
      },
      {
        "command": "timetracker.quickSwitch",
        "title": "Time Tracker: Quick Switch Project"
      },
      {
        "command": "timetracker.pomodoro.toggle",
        "title": "Time Tracker: Pomodoro - Toggle Menu"
      },
      {
        "command": "timetracker.pomodoro.start",
        "title": "Time Tracker: Pomodoro - Start Work Session"
      },
      {
        "command": "timetracker.pomodoro.pause",
        "title": "Time Tracker: Pomodoro - Pause"
      },
      {
        "command": "timetracker.pomodoro.resume",
        "title": "Time Tracker: Pomodoro - Resume"
      },
      {
        "command": "timetracker.pomodoro.stop",
        "title": "Time Tracker: Pomodoro - Stop"
      },
      {
        "command": "timetracker.pomodoro.skip",
        "title": "Time Tracker: Pomodoro - Skip Phase"
      }
    ],
    "keybindings": [
      {
        "command": "timetracker.quickSwitch",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "timetracker.pomodoro.toggle",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "timetracker.startTracking",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "timetracker.stopTracking",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "timetracker",
          "title": "Time Tracker",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "timetracker": [
        {
          "type": "webview",
          "id": "timetracker.sidebar",
          "name": "Time Tracker"
        }
      ]
    },
    "configuration": {
      "title": "Time Tracker",
      "properties": {
        "timetracker.idleTimeout": {
          "type": "number",
          "default": 5,
          "description": "Minutes of inactivity before pausing tracking"
        },
        "timetracker.minSessionDuration": {
          "type": "number",
          "default": 1,
          "description": "Minimum session duration in minutes to record"
        },
        "timetracker.excludedProjects": {
          "type": "array",
          "default": [],
          "description": "Project paths or names to exclude from tracking"
        },
        "timetracker.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start tracking when opening a project"
        },
        "timetracker.workingHoursStart": {
          "type": "string",
          "default": "09:00",
          "description": "Working hours start time (HH:MM)"
        },
        "timetracker.workingHoursEnd": {
          "type": "string",
          "default": "17:00",
          "description": "Working hours end time (HH:MM)"
        },
        "timetracker.dataRetentionDays": {
          "type": "number",
          "default": 365,
          "description": "Number of days to retain data (0 = forever)"
        },
        "timetracker.synergy.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Synergy PSA integration"
        },
        "timetracker.synergy.resId": {
          "type": "number",
          "default": null,
          "description": "Synergy Resource ID for fetching customers"
        },
        "timetracker.synergy.apiUrl": {
          "type": "string",
          "default": "https://synergy.esc.be/TopDeskAPI_CRM",
          "description": "Synergy API base URL (for direct API access)"
        },
        "timetracker.synergy.apiEndpoint": {
          "type": "string",
          "default": "https://synergy.esc.be/TopDeskAPI_CRM/api/Request",
          "description": "Synergy API endpoint URL"
        },
        "timetracker.synergy.tokenEndpoint": {
          "type": "string",
          "default": "https://handleteamscallrecordwebhook.azurewebsites.net:443/api/ReturnSynergyAccesToken/triggers/manual/invoke?api-version=2020-05-01-preview&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=vmB_g4-6eXhhbn_C6sfBonXqWnZVWtozUEM1e1JFtyI",
          "description": "Synergy token endpoint URL"
        },
        "timetracker.synergy.winterHourCheckEndpoint": {
          "type": "string",
          "default": "https://handleteamscallrecordwebhook.azurewebsites.net:443/api/CalculateWinterHourIsNeeded/triggers/manual/invoke?api-version=2022-05-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=gpHmI_AuviEbhpI9SgcotY0Fp56RHcTWYJh67Z102qA",
          "description": "Synergy winter hour check endpoint URL"
        },
        "timetracker.synergy.customersEndpoint": {
          "type": "string",
          "default": "https://handleteamscallrecordwebhook.azurewebsites.net:443/api/ReturnSynergyCustomers/triggers/manual/invoke?api-version=2020-05-01-preview&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=dZTOockMmIM-4Wj8AYzNO9iwIOFDjJK7BYB4VihJ6Bc",
          "description": "Synergy customers endpoint URL"
        },
        "timetracker.synergy.customerEndpoint": {
          "type": "string",
          "default": "https://synergy.esc.be/TopDeskAPI_CRM/api/Customer/GetRelationDataByResId",
          "description": "Synergy API direct customer endpoint URL"
        },
        "timetracker.synergy.projectsEndpoint": {
          "type": "string",
          "default": "https://handleteamscallrecordwebhook.azurewebsites.net:443/api/ReturnSynergyProjects/triggers/manual/invoke?api-version=2022-05-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=OZxUzs96HCgkFcM9wuA_sVOAQBEA23TQBZWK3as9xro",
          "description": "Synergy projects endpoint URL"
        },
        "timetracker.synergy.defaultCustomerId": {
          "type": "string",
          "default": "15afd034-ce8a-449c-af83-b169db07fbcd",
          "description": "Default Synergy customer ID (ESC GUID)"
        },
        "timetracker.synergy.defaultProject": {
          "type": "string",
          "default": "ESC-TEAMS-CALL",
          "description": "Default Synergy project code"
        },
        "timetracker.synergy.resourceId": {
          "type": "number",
          "description": "Your Synergy resource ID (employee ID)"
        },
        "timetracker.synergy.defaultActivity": {
          "type": "string",
          "enum": ["CONSULTANCY", "DEVELOPMENT"],
          "default": "CONSULTANCY",
          "description": "Default activity type for Synergy submissions"
        },
        "timetracker.synergy.username": {
          "type": "string",
          "default": "",
          "description": "Synergy API username (for direct API access)"
        },
        "timetracker.synergy.password": {
          "type": "string",
          "default": "",
          "description": "Synergy API password (for direct API access). WARNING: Stored in VS Code settings - consider using Azure Logic Apps authentication instead for better security."
        },
        "timetracker.synergy.autoSync": {
          "type": "boolean",
          "default": false,
          "description": "Automatically sync time entries to Synergy when they are completed"
        },
        "timetracker.synergy.email": {
          "type": "string",
          "default": "",
          "description": "User email address for fetching Synergy ResID"
        },
        "timetracker.synergy.employeeId": {
          "type": "string",
          "default": "",
          "description": "Employee ID (ResID) for fetching Synergy projects (optional if email is provided)"
        },
        "timetracker.synergy.projectsEndpointUrl": {
          "type": "string",
          "default": "https://default8e426d61a69d49278a3fef2f62da7f.57.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/22875bb4fbe842878aa259258da3282e/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=AstmvDgfeuxKoNh5UUeRpqScE6wvhwBE17W6tGDucWs",
          "description": "Power Automate endpoint URL for fetching Synergy projects"
        },
        "timetracker.synergy.resIdEndpointUrl": {
          "type": "string",
          "default": "https://default8e426d61a69d49278a3fef2f62da7f.57.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/2a6aeb0a4dd04785a7e49d8a03702975/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=dvAvMPws4G4Dm846yzL8Akkp0GboBOlsifL19VT6s7w",
          "description": "Power Automate endpoint URL for fetching ResID from email"
        },
        "timetracker.pomodoro.workDuration": {
          "type": "number",
          "default": 25,
          "description": "Work session duration in minutes"
        },
        "timetracker.pomodoro.shortBreakDuration": {
          "type": "number",
          "default": 5,
          "description": "Short break duration in minutes"
        },
        "timetracker.pomodoro.longBreakDuration": {
          "type": "number",
          "default": 15,
          "description": "Long break duration in minutes"
        },
        "timetracker.pomodoro.cyclesBeforeLongBreak": {
          "type": "number",
          "default": 4,
          "description": "Number of work cycles before a long break"
        },
        "timetracker.pomodoro.autoPauseOnBreak": {
          "type": "boolean",
          "default": true,
          "description": "Automatically pause time tracking during Pomodoro breaks"
        },
        "timetracker.pomodoro.autoResumeAfterBreak": {
          "type": "boolean",
          "default": false,
          "description": "Automatically resume time tracking after Pomodoro breaks"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "@typescript-eslint/parser": "^5.30.0",
    "eslint": "^8.18.0",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chart.js": "^4.3.0",
    "sql.js": "^1.13.0"
  }
}
